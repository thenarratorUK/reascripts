desc:Adaptive Reference Matcher
// @description Fixed-anchor adaptive mono narration EQ with 14 embedded references
// @author David Winter
// @version 0.6.0
// @about
//   Branded custom-interface release. Learns and persists a fixed source
//   anchor, combines linear reference matching with live self-consistency, and
//   applies the resulting detailed curve through minimum-phase or linear-phase
//   partitioned convolution. Stereo input is physically collapsed to mono and
//   copied to both outputs.

tags: analysis fft mono narration reference matching
filename:0,adaptive-eq-gui@2x.png
filename:1,adaptive-eq-gui.png
options:maxmem=4000000

slider1:reference_select=0<0,14,1{None - Consistency Only,Alto 1 - Tess,Alto 2 - Andrea,Alto 3 - Amy,Baritone 1 - Luke,Baritone 2 - Jack,Baritone 3 - John,Bass 1 - Hakim,Bass 2 - Michael,Soprano 1 - Erin,Soprano 2 - Moira,Soprano 3 - Julia,Tenor 1 - Heath,Tenor 2 - Kyle,The Royer Track}>-Reference
slider2:learn_duration_seconds=30<10,300,1>-Learn duration (seconds)
slider3:learn_action=0<0,1,1{Idle,Learn}>-Learn source
slider4:reset_action=0<0,1,1{Keep learned source,Reset learned source}>-Reset source
slider5:reference_low_hz=20<20,20000,0.01:log>-Reference range low (Hz)
slider6:reference_high_hz=20000<20,20000,0.01:log>-Reference range high (Hz)
slider7:reference_strength=66<0,200,1>-Reference strength
slider8:adaptivity=50<0,100,1>-Adaptivity
slider9:frequency_smoothing=50<0,100,1>-Frequency smoothing
slider10:phase_mode=0<0,1,1{Minimum phase,Linear phase}>-Processing phase
slider11:learn_progress_percent=0<0,100,0.1>-Learn progress (%)
slider12:accepted_observations=0<0,160,1>-Accepted observations
slider13:anchor_status=0<0,4,1{No learned source,Learning,Finalising,Learned source held,Insufficient evidence}>-Source status
slider14:auto_gain=1<0,1,1{Off,On}>-Auto gain
slider15:internal_bypass=0<0,1,1{Active,Bypassed}>-Bypass

in_pin:mono / left input
in_pin:right input (summed)
out_pin:mono output
out_pin:mono output

@init

  // REAPER otherwise reruns @init on every transport start, which would erase
  // an armed capture before the first playback sample reaches @sample.
  ext_noinit = 1;

  STATE_VERSION = 1;
  FFT_SIZE = 32768;
  LEARN_FFT_HOP = 8192;
  LEARN_HOP_REFERENCE_RATE = 48000;
  LIVE_ANALYSIS_RATE_HZ = 50;
  PROCESS_FILTER_UPDATE_HZ = 10;
  DISPLAY_AVERAGE_SECONDS = 0.15;
  PROFILE_BINS = 240;
  BINS_PER_OCTAVE = 24;
  MIN_FREQUENCY_HZ = 20;
  MAX_FREQUENCY_HZ = 20000;
  NORMALISE_LOW_HZ = 80;
  NORMALISE_HIGH_HZ = 12000;
  OBSERVATION_SECONDS = 2;
  MIN_FRAMES_PER_OBSERVATION = 3;
  MIN_VALID_OBSERVATIONS = 12;
  MIN_VALID_OBSERVATION_FLOOR = 3;
  MAX_INVALID_OBSERVATIONS = 2;
  CAPTURE_FRAME_CAPACITY = 1800;
  CAPTURE_OBSERVATION_CAPACITY = 160;
  CAPTURE_GATE_ATTACK_SECONDS = 0.01;
  CAPTURE_GATE_RELEASE_SECONDS = 0.10;
  GATE_ABSOLUTE_DBFS = -70;
  GATE_BELOW_P90_DB = 30;
  TRIM_PROPORTION = 0.10;
  RANGE_TAPER_OCTAVES = 1;
  MAXIMUM_CORRECTION_Q = 6;
  MAXIMUM_SMOOTHING_SIGMA_BINS = 13.33;
  CONSISTENCY_STRENGTH_FRACTION = 0.25;
  CONSISTENCY_OUTSIDE_RANGE_SCALE = 0.35;
  LIVE_FULL_SUPPORT_REL_DB = -35;
  LIVE_ZERO_SUPPORT_REL_DB = -55;
  LIVE_GATE_RELEASE_DB_PER_SECOND = 6;
  PROCESS_FIR_SIZE = 16384;
  PROCESS_PARTITION_SIZE = 512;
  PROCESS_FFT_SIZE = 1024;
  PROCESS_PARTITIONS = 32;
  LINEAR_PHASE_DELAY = PROCESS_FIR_SIZE/2;
  EPSILON = 0.00000000000000000001;
  DB_SCALE_POWER = 10/log(10);
  DB_SCALE_AMPLITUDE = 20/log(10);

  // Embedded profile memory.
  profile_mean_db = 0;
  profile_deviation_db = 4000;
  profile_confidence = 8000;

  // Runtime analysis memory.
  window = 12000;
  analysis_ring = 46000;
  fft_workspace = 79000;
  source_anchor_db = 112000;
  reference_raw_db = 112240;
  reference_smoothed_db = 112480;
  reference_correction_db = 112720;
  adaptive_residual_db = 112960;
  total_correction_db = 113200;
  adaptive_state_db = 113440;
  sort_workspace = 114000;
  observation_counts = 122000;
  observation_shape_db = 123000;
  frame_rms_db = 160000;
  frame_band_power = 162000;
  recent_frame_power = 600000;
  recent_power_ema = 600240;
  recent_shape_db = 600480;
  adaptive_raw_db = 600720;
  adaptive_smoothed_db = 600960;
  display_power_ema = 601200;
  display_shape_db = 601440;

  // Uniform partitioned-convolution memory. Complex FFT buffers use two
  // scalar slots per point: real, imaginary.
  process_kernel_workspace = 610000;
  process_partition_workspace = 643000;
  process_output_spectrum = 645100;
  process_input_spectra = 648000;
  process_filter_spectra = 714000;
  process_input_block = 780000;
  process_output_block = 781000;
  process_overlap = 782000;

  // BEGIN INLINED DERIVED REFERENCE DATA
// Adaptive Reference Matcher reference data
// Profile format version 1. Derived numerical data only; no source audio.
profile_format_version = 1;
profile_count = 14;
profile_bin_count = 240;
profile_bins_per_octave = 24;
profile_min_frequency_hz = 20.000000;

// Display names in profile-index order:
// 0: Alto 1 (Tess Irondale) [alto_1_tess_irondale]
// 1: Alto 2 (Andrea Parsneau) [alto_2_andrea_parsneau]
// 2: Alto 3 (Amy Landon) [alto_3_amy_landon]
// 3: Baritone 1 (Luke Daniels) [baritone_1_luke_daniels]
// 4: Baritone 2 (Jack Voraces) [baritone_2_jack_voraces]
// 5: Baritone 3 (Johnathan McClain) [baritone_3_johnathan_mcclain]
