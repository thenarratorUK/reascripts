// END INLINED DERIVED REFERENCE DATA

  function set_profile_name(index)
  (
    index == 0 ? #profile_name = "None - Consistency Only" :
    index == 1 ? #profile_name = "Alto 1 - Tess" :
    index == 2 ? #profile_name = "Alto 2 - Andrea" :
    index == 3 ? #profile_name = "Alto 3 - Amy" :
    index == 4 ? #profile_name = "Baritone 1 - Luke" :
    index == 5 ? #profile_name = "Baritone 2 - Jack" :
    index == 6 ? #profile_name = "Baritone 3 - John" :
    index == 7 ? #profile_name = "Bass 1 - Hakim" :
    index == 8 ? #profile_name = "Bass 2 - Michael" :
    index == 9 ? #profile_name = "Soprano 1 - Erin" :
    index == 10 ? #profile_name = "Soprano 2 - Moira" :
    index == 11 ? #profile_name = "Soprano 3 - Julia" :
    index == 12 ? #profile_name = "Tenor 1 - Heath" :
    index == 13 ? #profile_name = "Tenor 2 - Kyle" :
    #profile_name = "The Royer Track";
  );

  function reference_range_taper(frequency)
    local(low, high, half_taper, low_zero, low_full, high_full, high_zero,
          low_amount, high_amount)
  (
    low = reference_low_hz;
    high = reference_high_hz;
    high <= low ? 0 : (
      half_taper = RANGE_TAPER_OCTAVES/2;
      low_zero = low/exp(log(2)*half_taper);
      low_full = low*exp(log(2)*half_taper);
      high_full = high/exp(log(2)*half_taper);
      high_zero = high*exp(log(2)*half_taper);
      low <= MIN_FREQUENCY_HZ ? low_amount = 1 :
      frequency <= low_zero ? low_amount = 0 :
      frequency >= low_full ? low_amount = 1 :
        low_amount = 0.5-0.5*cos($pi*log(frequency/low_zero)/
          max(EPSILON, log(low_full/low_zero)));
      high >= MAX_FREQUENCY_HZ ? high_amount = 1 :
      frequency >= high_zero ? high_amount = 0 :
      frequency <= high_full ? high_amount = 1 :
        high_amount = 0.5-0.5*cos($pi*log(high_zero/frequency)/
          max(EPSILON, log(high_zero/high_full)));
      min(low_amount, high_amount);
    );
  );

  function smoothing_sigma_bins()
    local(minimum_sigma, smoothing_fraction)
  (
    // Smart EQ's zero setting remains a continuously rounded EQ curve. Its
    // narrowest visible features are approximately Q=6; the supplied endpoint
    // screenshots place maximum smoothing at about 13.3 profile bins.
    minimum_sigma = BINS_PER_OCTAVE/
      (2.355*MAXIMUM_CORRECTION_Q*log(2));
    smoothing_fraction = frequency_smoothing/100;
    minimum_sigma + (MAXIMUM_SMOOTHING_SIGMA_BINS-minimum_sigma)*
      smoothing_fraction*smoothing_fraction;
  );

  function recent_average_seconds_for_adaptivity()
  (
    // Exponential control law preserves the deliberately slow minimum while
    // making maximum Adaptivity follow each 50 Hz analysis measurement.
    exp(log(20) + (log(0.02)-log(20))*adaptivity/100);
  );

  function settling_seconds_for_adaptivity()
  (
    exp(log(18) + (log(0.02)-log(18))*adaptivity/100);
  );

  function correction_db_at_frequency(frequency)
    local(position, lower_bin, upper_bin, fraction, last_frequency)
  (
    internal_bypass ? 0 :
    frequency <= 0 || frequency > MAX_FREQUENCY_HZ ? 0 :
    frequency <= MIN_FREQUENCY_HZ ? total_correction_db[0] : (
      position = BINS_PER_OCTAVE*log(frequency/MIN_FREQUENCY_HZ)/log(2);
      lower_bin = floor(position);
      lower_bin >= PROFILE_BINS-1 ? (
        last_frequency = MIN_FREQUENCY_HZ*
          exp(log(2)*(PROFILE_BINS-1)/BINS_PER_OCTAVE);
        total_correction_db[PROFILE_BINS-1]*
          max(0, (MAX_FREQUENCY_HZ-frequency)/
            max(EPSILON, MAX_FREQUENCY_HZ-last_frequency));
      ) : (
        lower_bin = max(0, lower_bin);
        upper_bin = lower_bin+1;
        fraction = max(0, min(1, position-lower_bin));
        total_correction_db[lower_bin]*(1-fraction) +
          total_correction_db[upper_bin]*fraction;
      );
    );
  );

  function set_processing_delay()
  (
    pdc_bot_ch = 0;
    pdc_top_ch = 2;
    pdc_delay = PROCESS_PARTITION_SIZE +
      (phase_mode >= 0.5 ? LINEAR_PHASE_DELAY : 0);
    ext_tail_size = PROCESS_FIR_SIZE + PROCESS_PARTITION_SIZE;
  );

  function calculate_auto_gain()
    local(bin_index, weight, input_power, output_power, correction)
  (
    auto_gain_db = 0;
    auto_gain && learned_valid && !internal_bypass ? (
      input_power = 0;
      output_power = 0;
      bin_index = 0;
      loop(PROFILE_BINS,
        weight = live_initialized ? recent_power_ema[bin_index] :
          exp(source_anchor_db[bin_index]/DB_SCALE_POWER);
        correction = total_correction_db[bin_index];
        input_power += weight;
        output_power += weight*exp(correction/DB_SCALE_POWER);
        bin_index += 1;
      );
      auto_gain_db = -DB_SCALE_POWER*
        log(max(EPSILON, output_power)/max(EPSILON, input_power));
      auto_gain_db = max(-12, min(12, auto_gain_db));
    );
    auto_gain_linear = exp(auto_gain_db/DB_SCALE_AMPLITUDE);
  );

  function reset_processing_runtime()
  (
    memset(process_input_spectra, 0,
      PROCESS_PARTITIONS*2*PROCESS_FFT_SIZE);
    memset(process_input_block, 0, PROCESS_PARTITION_SIZE);
    memset(process_output_block, 0, PROCESS_PARTITION_SIZE);
    memset(process_overlap, 0, PROCESS_PARTITION_SIZE);
    process_collect_count = 0;
    process_output_read = 0;
    process_history_slot = -1;
  );

  function build_processing_filter()
    local(index, frequency, correction_db, log_magnitude, magnitude,
          cepstrum_value, cepstrum_scale, phase, real_value, imaginary_value,
          partition_index, partition_offset, sample_index, kernel_index)
  (
    // Build a causal impulse from the exact same interpolated total curve used
    // by the graph. Linear phase is a symmetric response delayed to the centre
    // of the FIR. Minimum phase is obtained by real-cepstrum spectral
    // factorisation and therefore concentrates energy at the start.
    calculate_auto_gain();
    phase_mode >= 0.5 ? (
      index = 0;
      loop(PROCESS_FIR_SIZE,
        frequency = index <= PROCESS_FIR_SIZE/2 ?
          index*srate/PROCESS_FIR_SIZE :
          (PROCESS_FIR_SIZE-index)*srate/PROCESS_FIR_SIZE;
        correction_db = correction_db_at_frequency(frequency);
        magnitude = exp(correction_db/DB_SCALE_AMPLITUDE);
        // A half-length delay is exactly (-1)^bin for this even FFT size.
        process_kernel_workspace[2*index] =
          (index%2 ? -magnitude : magnitude);
        process_kernel_workspace[2*index+1] = 0;
        index += 1;
      );
      fft_ipermute(process_kernel_workspace, PROCESS_FIR_SIZE);
      ifft(process_kernel_workspace, PROCESS_FIR_SIZE);
    ) : (
      // Natural-order, conjugate-symmetric real log-magnitude spectrum.
      index = 0;
      loop(PROCESS_FIR_SIZE,
        frequency = index <= PROCESS_FIR_SIZE/2 ?
          index*srate/PROCESS_FIR_SIZE :
          (PROCESS_FIR_SIZE-index)*srate/PROCESS_FIR_SIZE;
        correction_db = correction_db_at_frequency(frequency);
        process_kernel_workspace[2*index] =
          correction_db/DB_SCALE_AMPLITUDE;
        process_kernel_workspace[2*index+1] = 0;
        index += 1;
      );

      // Real cepstrum: keep DC/Nyquist, double positive quefrencies, and
      // remove negative quefrencies before exponentiating the complex log.
      fft_ipermute(process_kernel_workspace, PROCESS_FIR_SIZE);
      ifft(process_kernel_workspace, PROCESS_FIR_SIZE);
      index = 0;
      loop(PROCESS_FIR_SIZE,
        cepstrum_value = process_kernel_workspace[2*index]/PROCESS_FIR_SIZE;
        cepstrum_scale = index == 0 || index == PROCESS_FIR_SIZE/2 ? 1 :
          index < PROCESS_FIR_SIZE/2 ? 2 : 0;
        process_kernel_workspace[2*index] =
          cepstrum_value*cepstrum_scale;
        process_kernel_workspace[2*index+1] = 0;
        index += 1;
      );
      fft(process_kernel_workspace, PROCESS_FIR_SIZE);
      fft_permute(process_kernel_workspace, PROCESS_FIR_SIZE);
      index = 0;
      loop(PROCESS_FIR_SIZE,
        log_magnitude = process_kernel_workspace[2*index];
        phase = process_kernel_workspace[2*index+1];
        magnitude = exp(log_magnitude);
        process_kernel_workspace[2*index] = magnitude*cos(phase);
        process_kernel_workspace[2*index+1] = magnitude*sin(phase);
        index += 1;
      );
      fft_ipermute(process_kernel_workspace, PROCESS_FIR_SIZE);
      ifft(process_kernel_workspace, PROCESS_FIR_SIZE);
    );

    // Transform each 512-sample impulse partition into a 1,024-point spectrum.
    // The impulse IFFT is normalised here; block IFFT normalisation happens in
    // process_audio_block().
    partition_index = 0;
    loop(PROCESS_PARTITIONS,
      memset(process_partition_workspace, 0, 2*PROCESS_FFT_SIZE);
      partition_offset = partition_index*PROCESS_PARTITION_SIZE;
      sample_index = 0;
      loop(PROCESS_PARTITION_SIZE,
        kernel_index = partition_offset+sample_index;
        process_partition_workspace[2*sample_index] =
          process_kernel_workspace[2*kernel_index]/PROCESS_FIR_SIZE;
        process_partition_workspace[2*sample_index+1] = 0;
        sample_index += 1;
      );
      fft(process_partition_workspace, PROCESS_FFT_SIZE);
      fft_permute(process_partition_workspace, PROCESS_FFT_SIZE);
      memcpy(process_filter_spectra+
        partition_index*2*PROCESS_FFT_SIZE,
        process_partition_workspace, 2*PROCESS_FFT_SIZE);
      partition_index += 1;
    );

    process_filter_dirty = 0;
    process_filter_force = 0;
    process_filter_elapsed_samples = 0;
    set_processing_delay();
  );

  function process_audio_block()
    local(history_offset, partition_index, history_index, filter_offset,
          spectrum_index, input_real, input_imaginary, filter_real,
          filter_imaginary, output_real, output_imaginary, sample_index)
  (
    process_history_slot += 1;
    process_history_slot >= PROCESS_PARTITIONS ? process_history_slot = 0;
    history_offset = process_history_slot*2*PROCESS_FFT_SIZE;

    memset(process_partition_workspace, 0, 2*PROCESS_FFT_SIZE);
    sample_index = 0;
    loop(PROCESS_PARTITION_SIZE,
      process_partition_workspace[2*sample_index] =
        process_input_block[sample_index];
      sample_index += 1;
    );
    fft(process_partition_workspace, PROCESS_FFT_SIZE);
    fft_permute(process_partition_workspace, PROCESS_FFT_SIZE);
    memcpy(process_input_spectra+history_offset,
      process_partition_workspace, 2*PROCESS_FFT_SIZE);

    memset(process_output_spectrum, 0, 2*PROCESS_FFT_SIZE);
    partition_index = 0;
    loop(PROCESS_PARTITIONS,
      history_index = process_history_slot-partition_index;
      history_index < 0 ? history_index += PROCESS_PARTITIONS;
      history_offset = history_index*2*PROCESS_FFT_SIZE;
      filter_offset = partition_index*2*PROCESS_FFT_SIZE;
      spectrum_index = 0;
      loop(PROCESS_FFT_SIZE,
        input_real = process_input_spectra[history_offset+2*spectrum_index];
        input_imaginary =
          process_input_spectra[history_offset+2*spectrum_index+1];
        filter_real = process_filter_spectra[filter_offset+2*spectrum_index];
        filter_imaginary =
          process_filter_spectra[filter_offset+2*spectrum_index+1];
        process_output_spectrum[2*spectrum_index] +=
          input_real*filter_real-input_imaginary*filter_imaginary;
        process_output_spectrum[2*spectrum_index+1] +=
          input_real*filter_imaginary+input_imaginary*filter_real;
        spectrum_index += 1;
      );
      partition_index += 1;
    );

    fft_ipermute(process_output_spectrum, PROCESS_FFT_SIZE);
    ifft(process_output_spectrum, PROCESS_FFT_SIZE);
    sample_index = 0;
    loop(PROCESS_PARTITION_SIZE,
      process_output_block[sample_index] =
        process_output_spectrum[2*sample_index]/PROCESS_FFT_SIZE +
        process_overlap[sample_index];
      process_overlap[sample_index] =
        process_output_spectrum[2*(sample_index+PROCESS_PARTITION_SIZE)]/
          PROCESS_FFT_SIZE;
      sample_index += 1;
    );
  );

  function refresh_combined_curve()
    local(selected_profile, bin_index, frequency, range_scale, correction)
  (
    selected_profile = (reference_select|0)-1;
    adaptive_peak_db = 0;
    bin_index = 0;
    loop(PROFILE_BINS,
      frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
      range_scale = selected_profile >= 0 ?
        CONSISTENCY_OUTSIDE_RANGE_SCALE +
        (1-CONSISTENCY_OUTSIDE_RANGE_SCALE)*reference_range_taper(frequency) : 1;
      correction = adaptive_state_db[bin_index]*range_scale;
      adaptive_residual_db[bin_index] = correction;
      total_correction_db[bin_index] =
        reference_correction_db[bin_index] + correction;
      adaptive_peak_db = max(adaptive_peak_db, abs(correction));
      bin_index += 1;
    );
    process_filter_dirty = 1;
  );

  function reset_live_analysis()
  (
    memset(analysis_ring, 0, FFT_SIZE);
    memset(recent_frame_power, 0, PROFILE_BINS);
    memset(recent_power_ema, 0, PROFILE_BINS);
    memset(recent_shape_db, 0, PROFILE_BINS);
    memset(adaptive_raw_db, 0, PROFILE_BINS);
    memset(adaptive_smoothed_db, 0, PROFILE_BINS);
    memset(display_power_ema, 0, PROFILE_BINS);
    memset(display_shape_db, 0, PROFILE_BINS);
    memset(adaptive_state_db, 0, PROFILE_BINS);
    memset(adaptive_residual_db, 0, PROFILE_BINS);
    live_ring_write = 0;
    live_ring_filled = 0;
    live_hop_count = 0;
    live_frame_count = 0;
    live_valid_frames = 0;
    live_runtime_seconds = 0;
    live_evidence_seconds = 0;
    live_silence_seconds = 0;
    live_gate_reference_db = -120;
    live_initialized = 0;
    display_initialized = 0;
    adaptive_peak_db = 0;
    refresh_combined_curve();
    process_filter_force = 1;
  );

  function clear_source_anchor()
  (
    memset(source_anchor_db, 0, PROFILE_BINS);
    memset(reference_raw_db, 0, PROFILE_BINS);
    memset(reference_smoothed_db, 0, PROFILE_BINS);
    memset(reference_correction_db, 0, PROFILE_BINS);
    reset_live_analysis();
    learned_valid = 0;
    learned_observation_count = 0;
    accepted_observations = 0;
    required_observation_count = 0;
    learn_progress_percent = 0;
    anchor_status = 0;
    finalise_reason = 0;
    sliderchange(slider11);
    sliderchange(slider12);
    sliderchange(slider13);
  );

  function required_learn_observations()
    local(possible_observations)
  (
    possible_observations = ceil(learn_duration_seconds/OBSERVATION_SECONDS);
    min(MIN_VALID_OBSERVATIONS, max(
      MIN_VALID_OBSERVATION_FLOOR,
      possible_observations-MAX_INVALID_OBSERVATIONS));
  );

  function reset_capture()
  (
    reset_live_analysis();
    learn_hop_samples = max(1, floor(
      LEARN_FFT_HOP*srate/LEARN_HOP_REFERENCE_RATE + 0.5));
    max_capture_frames = min(CAPTURE_FRAME_CAPACITY,
      ceil(learn_duration_seconds*srate/learn_hop_samples) + 8);
    max_capture_observations = min(CAPTURE_OBSERVATION_CAPACITY,
      ceil(learn_duration_seconds/OBSERVATION_SECONDS) + 3);
    memset(analysis_ring, 0, FFT_SIZE);
    memset(frame_rms_db, 0, max_capture_frames);
    memset(frame_band_power, 0, max_capture_frames*PROFILE_BINS);
    memset(observation_counts, 0, max_capture_observations);
    memset(observation_shape_db, 0, max_capture_observations*PROFILE_BINS);
    capture_ring_write = 0;
    capture_ring_filled = 0;
    capture_hop_count = 0;
    capture_frame_count = 0;
    capture_sample_count = 0;
    capture_usable_sample_count = 0;
    capture_gate_power = 0;
    capture_gate_peak_db = -120;
    capture_online_gate_db = GATE_ABSOLUTE_DBFS;
    capture_gate_attack = 1-exp(-1/max(1,
      CAPTURE_GATE_ATTACK_SECONDS*srate));
    capture_gate_release = 1-exp(-1/max(1,
      CAPTURE_GATE_RELEASE_SECONDS*srate));
    capture_started_srate = srate;
    finalise_reason = 0;
    capture_active = 1;
    finalise_requested = 0;
    learn_progress_percent = 0;
    accepted_observations = 0;
    required_observation_count = required_learn_observations();
    anchor_status = 1;
    sliderchange(slider11);
    sliderchange(slider12);
    sliderchange(slider13);
  );

  function sort_values(base, count)
    local(i, j, key)
  (
    i = 1;
    while(i < count) (
      key = base[i];
      j = i - 1;
      while(j >= 0 && base[j] > key) (
        base[j+1] = base[j];
        j -= 1;
      );
      base[j+1] = key;
      i += 1;
    );
  );

  function calculate_reference_curve()
    local(selected_profile, profile_offset, bin_index, frequency, confidence,
          reference_sum, source_sum, weight_sum, reference_center,
          source_center, difference, smoothing_sigma,
          smoothing_radius, neighbour, neighbour_index, distance, weight,
          smoothed_sum, smoothed_weight, taper, correction)
  (
    memset(reference_raw_db, 0, PROFILE_BINS);
    memset(reference_smoothed_db, 0, PROFILE_BINS);
    memset(reference_correction_db, 0, PROFILE_BINS);

    selected_profile = (reference_select|0)-1;
    learned_valid && selected_profile >= 0 ? (
      profile_offset = selected_profile*PROFILE_BINS;
      reference_sum = 0;
      source_sum = 0;
      weight_sum = 0;
      bin_index = 0;
      loop(PROFILE_BINS,
        frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
        confidence = profile_confidence[profile_offset+bin_index];
        frequency >= reference_low_hz && frequency <= reference_high_hz &&
        confidence > 0 ? (
          reference_sum += profile_mean_db[profile_offset+bin_index]*confidence;
          source_sum += source_anchor_db[bin_index]*confidence;
          weight_sum += confidence;
        );
        bin_index += 1;
      );
      reference_center = reference_sum/max(EPSILON, weight_sum);
      source_center = source_sum/max(EPSILON, weight_sum);

      bin_index = 0;
      loop(PROFILE_BINS,
        confidence = profile_confidence[profile_offset+bin_index];
        difference = (profile_mean_db[profile_offset+bin_index]-reference_center) -
          (source_anchor_db[bin_index]-source_center);
        reference_raw_db[bin_index] = difference*reference_strength/100;
        bin_index += 1;
      );

      // Log-frequency Gaussian smoothing. The stored 24 bins/octave remain
      // available; this control decides how much detail becomes correction.
      smoothing_sigma = smoothing_sigma_bins();
      smoothing_radius = ceil(3*smoothing_sigma);
      bin_index = 0;
      loop(PROFILE_BINS,
        neighbour = -smoothing_radius;
        smoothed_sum = 0;
        smoothed_weight = 0;
        while(neighbour <= smoothing_radius) (
          neighbour_index = bin_index+neighbour;
          neighbour_index >= 0 && neighbour_index < PROFILE_BINS ? (
            distance = neighbour/smoothing_sigma;
            weight = exp(-0.5*distance*distance);
            smoothed_sum += reference_raw_db[neighbour_index]*weight;
            smoothed_weight += weight;
          );
          neighbour += 1;
        );
        reference_smoothed_db[bin_index] =
          smoothed_sum/max(EPSILON, smoothed_weight);
        bin_index += 1;
      );
      bin_index = 0;
      loop(PROFILE_BINS,
        frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
        taper = reference_range_taper(frequency);
        correction = reference_smoothed_db[bin_index]*taper;
        reference_correction_db[bin_index] = correction;
        bin_index += 1;
      );
    );
    refresh_combined_curve();
    process_filter_force = 1;
  );

  function smooth_adaptive_curve()
    local(smoothing_sigma, smoothing_radius, bin_index, neighbour,
          neighbour_index, distance, weight, smoothed_sum, smoothed_weight)
  (
    smoothing_sigma = smoothing_sigma_bins();
    smoothing_radius = ceil(3*smoothing_sigma);
    bin_index = 0;
    loop(PROFILE_BINS,
      neighbour = -smoothing_radius;
      smoothed_sum = 0;
      smoothed_weight = 0;
      while(neighbour <= smoothing_radius) (
        neighbour_index = bin_index+neighbour;
        neighbour_index >= 0 && neighbour_index < PROFILE_BINS ? (
          distance = neighbour/smoothing_sigma;
          weight = exp(-0.5*distance*distance);
          smoothed_sum += adaptive_raw_db[neighbour_index]*weight;
          smoothed_weight += weight;
        );
        neighbour += 1;
      );
      adaptive_smoothed_db[bin_index] =
        smoothed_sum/max(EPSILON, smoothed_weight);
      bin_index += 1;
    );
  );

  function update_consistency_target(update_immediately)
    local(bin_index, local_shape_level, support, evidence_factor,
          consistency_scale, consistency_target,
          settling_alpha)
  (
    evidence_factor = min(1, live_evidence_seconds/
      max(EPSILON, recent_average_seconds_for_adaptivity()));
    consistency_scale = CONSISTENCY_STRENGTH_FRACTION*
      reference_strength/100;
    adaptivity <= 0 ? consistency_scale = 0;
    settling_alpha = 1-exp(-live_hop_samples/max(1, srate)/
      max(EPSILON, settling_seconds_for_adaptivity()));
    bin_index = 0;
    loop(PROFILE_BINS,
      local_shape_level = min(source_anchor_db[bin_index],
        recent_shape_db[bin_index]);
      support = local_shape_level >= LIVE_FULL_SUPPORT_REL_DB ? 1 :
        local_shape_level <= LIVE_ZERO_SUPPORT_REL_DB ? 0 :
        (local_shape_level-LIVE_ZERO_SUPPORT_REL_DB)/
          (LIVE_FULL_SUPPORT_REL_DB-LIVE_ZERO_SUPPORT_REL_DB);
      consistency_target = adaptive_smoothed_db[bin_index]*
        support*evidence_factor*consistency_scale;
      update_immediately ?
        adaptive_state_db[bin_index] = consistency_target :
        adaptive_state_db[bin_index] += settling_alpha*
          (consistency_target-adaptive_state_db[bin_index]);
      bin_index += 1;
    );
    refresh_combined_curve();
  );

  function analyse_capture_frame()
    local(i, ring_index, sample_value, sum_squares, rms_value, bin_index,
          center, nominal_low, nominal_high, low, high, first_fft_bin,
          last_fft_bin, fft_bin, fft_frequency, left_width, right_width,
          weight, weight_sum, power_sum, real_value, imag_value, frame_offset,
          frequency_resolution, frame_rms_value_db, frame_is_usable)
  (
    capture_frame_count < max_capture_frames ? (
      i = 0;
      ring_index = capture_ring_write;
      sum_squares = 0;
      loop(FFT_SIZE,
        sample_value = analysis_ring[ring_index];
        fft_workspace[i] = sample_value*window[i];
        sum_squares += sample_value*sample_value;
        ring_index += 1;
        ring_index >= FFT_SIZE ? ring_index = 0;
        i += 1;
      );

      rms_value = sqrt(max(sum_squares/FFT_SIZE, EPSILON));
      frame_rms_value_db = DB_SCALE_AMPLITUDE*log(max(rms_value, EPSILON));
      frame_is_usable = frame_rms_value_db >= capture_online_gate_db;

      frame_is_usable ? (
        frame_rms_db[capture_frame_count] = frame_rms_value_db;

        fft_real(fft_workspace, FFT_SIZE);
        fft_permute(fft_workspace, FFT_SIZE/2);
        fft_workspace[1] = 0;

        frequency_resolution = srate/FFT_SIZE;
        frame_offset = capture_frame_count*PROFILE_BINS;
        bin_index = 0;
        loop(PROFILE_BINS,
          center = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
          nominal_low = center*exp(-0.5*log(2)/BINS_PER_OCTAVE);
          nominal_high = center*exp(0.5*log(2)/BINS_PER_OCTAVE);
          low = max(0, min(nominal_low, center - 2*frequency_resolution));
          high = max(nominal_high, center + 2*frequency_resolution);
          first_fft_bin = max(0, ceil(low/frequency_resolution));
          last_fft_bin = min(FFT_SIZE/2 - 1, floor(high/frequency_resolution));
          left_width = max(center-low, frequency_resolution);
          right_width = max(high-center, frequency_resolution);
          fft_bin = first_fft_bin;
          weight_sum = 0;
          power_sum = 0;
          while(fft_bin <= last_fft_bin) (
            fft_frequency = fft_bin*frequency_resolution;
            weight = fft_frequency <= center ?
              (fft_frequency-low)/left_width :
              (high-fft_frequency)/right_width;
            weight = max(0, weight);
            real_value = fft_workspace[2*fft_bin];
            imag_value = fft_workspace[2*fft_bin+1];
            power_sum += (real_value*real_value + imag_value*imag_value)*weight;
            weight_sum += weight;
            fft_bin += 1;
          );
          weight_sum <= EPSILON ? (
            fft_bin = min(FFT_SIZE/2 - 1, max(0, floor(center/frequency_resolution + 0.5)));
            real_value = fft_workspace[2*fft_bin];
            imag_value = fft_workspace[2*fft_bin+1];
            power_sum = real_value*real_value + imag_value*imag_value;
            weight_sum = 1;
          );
          frame_band_power[frame_offset+bin_index] = max(power_sum/weight_sum, EPSILON);
          bin_index += 1;
        );
        capture_frame_count += 1;
      );
    );
  );

  function analyse_live_frame()
    local(i, ring_index, sample_value, sum_squares, rms_value, frame_seconds,
          gate_db, frame_is_valid, bin_index, center, nominal_low, nominal_high,
          low, high, first_fft_bin, last_fft_bin, fft_bin, fft_frequency,
          left_width, right_width, weight, weight_sum, power_sum, real_value,
          imag_value, frequency_resolution, recent_average_seconds,
          average_alpha, display_average_alpha, normalise_sum, normalise_count,
          display_normalise_sum, display_normalise_count, frequency,
          recent_level, display_level, local_shape_level, support, difference,
          settling_seconds, settling_alpha, display_decay_alpha)
  (
    i = 0;
    ring_index = live_ring_write;
    sum_squares = 0;
    loop(FFT_SIZE,
      sample_value = analysis_ring[ring_index];
      fft_workspace[i] = sample_value*window[i];
      sum_squares += sample_value*sample_value;
      ring_index += 1;
      ring_index >= FFT_SIZE ? ring_index = 0;
      i += 1;
    );

    rms_value = sqrt(max(sum_squares/FFT_SIZE, EPSILON));
    live_frame_rms_db = DB_SCALE_AMPLITUDE*log(max(rms_value, EPSILON));
    frame_seconds = live_hop_samples/max(1, srate);
    live_gate_reference_db = max(live_frame_rms_db,
      live_gate_reference_db-LIVE_GATE_RELEASE_DB_PER_SECOND*frame_seconds);
    gate_db = max(GATE_ABSOLUTE_DBFS,
      live_gate_reference_db-GATE_BELOW_P90_DB);
    frame_is_valid = live_frame_rms_db >= gate_db;
    live_frame_count += 1;
    live_runtime_seconds += frame_seconds;

    recent_average_seconds = recent_average_seconds_for_adaptivity();
    settling_seconds = settling_seconds_for_adaptivity();
    settling_alpha = 1-exp(-frame_seconds/max(EPSILON, settling_seconds));

    frame_is_valid ? (
      fft_real(fft_workspace, FFT_SIZE);
      fft_permute(fft_workspace, FFT_SIZE/2);
      fft_workspace[1] = 0;

      frequency_resolution = srate/FFT_SIZE;
      bin_index = 0;
      loop(PROFILE_BINS,
        center = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
        nominal_low = center*exp(-0.5*log(2)/BINS_PER_OCTAVE);
        nominal_high = center*exp(0.5*log(2)/BINS_PER_OCTAVE);
        low = max(0, min(nominal_low, center - 2*frequency_resolution));
        high = max(nominal_high, center + 2*frequency_resolution);
        first_fft_bin = max(0, ceil(low/frequency_resolution));
        last_fft_bin = min(FFT_SIZE/2 - 1, floor(high/frequency_resolution));
        left_width = max(center-low, frequency_resolution);
        right_width = max(high-center, frequency_resolution);
        fft_bin = first_fft_bin;
        weight_sum = 0;
        power_sum = 0;
        while(fft_bin <= last_fft_bin) (
          fft_frequency = fft_bin*frequency_resolution;
          weight = fft_frequency <= center ?
            (fft_frequency-low)/left_width :
            (high-fft_frequency)/right_width;
          weight = max(0, weight);
          real_value = fft_workspace[2*fft_bin];
          imag_value = fft_workspace[2*fft_bin+1];
          power_sum += (real_value*real_value + imag_value*imag_value)*weight;
          weight_sum += weight;
          fft_bin += 1;
        );
        weight_sum <= EPSILON ? (
          fft_bin = min(FFT_SIZE/2 - 1,
            max(0, floor(center/frequency_resolution + 0.5)));
          real_value = fft_workspace[2*fft_bin];
          imag_value = fft_workspace[2*fft_bin+1];
          power_sum = real_value*real_value + imag_value*imag_value;
          weight_sum = 1;
        );
        recent_frame_power[bin_index] = max(power_sum/weight_sum, EPSILON);
        bin_index += 1;
      );

      average_alpha = live_initialized ?
        1-exp(-frame_seconds/max(EPSILON, recent_average_seconds)) : 1;
      display_average_alpha = display_initialized ?
        1-exp(-frame_seconds/DISPLAY_AVERAGE_SECONDS) : 1;
      bin_index = 0;
      loop(PROFILE_BINS,
        recent_power_ema[bin_index] += average_alpha*
          (recent_frame_power[bin_index]-recent_power_ema[bin_index]);
        display_power_ema[bin_index] += display_average_alpha*
          (recent_frame_power[bin_index]-display_power_ema[bin_index]);
        bin_index += 1;
      );
      live_initialized = 1;
      display_initialized = 1;
      live_valid_frames += 1;
      live_evidence_seconds = min(120, live_evidence_seconds+frame_seconds);
      live_silence_seconds = 0;

      normalise_sum = 0;
      normalise_count = 0;
      display_normalise_sum = 0;
      display_normalise_count = 0;
      bin_index = 0;
      loop(PROFILE_BINS,
        frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
        recent_level = DB_SCALE_POWER*log(max(recent_power_ema[bin_index], EPSILON));
        display_level = DB_SCALE_POWER*log(max(display_power_ema[bin_index], EPSILON));
        recent_shape_db[bin_index] = recent_level;
        display_shape_db[bin_index] = display_level;
        frequency >= NORMALISE_LOW_HZ && frequency <= NORMALISE_HIGH_HZ ? (
          normalise_sum += recent_level;
          normalise_count += 1;
          display_normalise_sum += display_level;
          display_normalise_count += 1;
        );
        bin_index += 1;
      );
      normalise_sum /= max(1, normalise_count);
      display_normalise_sum /= max(1, display_normalise_count);

      bin_index = 0;
      loop(PROFILE_BINS,
        recent_shape_db[bin_index] -= normalise_sum;
        display_shape_db[bin_index] -= display_normalise_sum;
        local_shape_level = min(source_anchor_db[bin_index],
          recent_shape_db[bin_index]);
        support = local_shape_level >= LIVE_FULL_SUPPORT_REL_DB ? 1 :
          local_shape_level <= LIVE_ZERO_SUPPORT_REL_DB ? 0 :
          (local_shape_level-LIVE_ZERO_SUPPORT_REL_DB)/
            (LIVE_FULL_SUPPORT_REL_DB-LIVE_ZERO_SUPPORT_REL_DB);
        difference = source_anchor_db[bin_index]-recent_shape_db[bin_index];
        adaptive_raw_db[bin_index] = learned_valid ? difference*support : 0;
        bin_index += 1;
      );

      smooth_adaptive_curve();
      update_consistency_target(0);
    ) : (
      live_silence_seconds += frame_seconds;
      display_decay_alpha = 1-exp(-frame_seconds/0.25);
      bin_index = 0;
      loop(PROFILE_BINS,
        adaptive_state_db[bin_index] += settling_alpha*
          (0-adaptive_state_db[bin_index]);
        display_shape_db[bin_index] += display_decay_alpha*
          (-60-display_shape_db[bin_index]);
        bin_index += 1;
      );
      live_silence_seconds > 1 ? display_initialized = 0;
      live_silence_seconds > 2*recent_average_seconds ? (
        memset(recent_power_ema, 0, PROFILE_BINS);
        memset(recent_shape_db, 0, PROFILE_BINS);
        live_initialized = 0;
        live_evidence_seconds = 0;
      );
    );

    // update_consistency_target() refreshes after valid frames. Silence has no
    // new target calculation, so publish its decay here.
    !frame_is_valid ? refresh_combined_curve();
  );

  function finalise_source_learning()
    local(i, percentile_position, percentile_low, percentile_high,
          percentile_fraction, p90_db, gate_db, frame_index, group_index,
          accepted_count, frame_offset, group_offset, bin_index, observation_index,
          frequency, normalise_sum, normalise_count, observation_level,
          valid_observations, trim_count, first_kept, last_kept, value_sum,
          value_count, anchor_normalise_sum, anchor_normalise_count)
  (
    capture_active = 0;
    anchor_status = 2;
    sliderchange(slider13);

    capture_frame_count >= 12 ? (
      i = 0;
      loop(capture_frame_count,
        sort_workspace[i] = frame_rms_db[i];
        i += 1;
      );
      sort_values(sort_workspace, capture_frame_count);
      percentile_position = 0.90*(capture_frame_count-1);
      percentile_low = floor(percentile_position);
      percentile_high = ceil(percentile_position);
      percentile_fraction = percentile_position-percentile_low;
      p90_db = sort_workspace[percentile_low]*(1-percentile_fraction) +
               sort_workspace[percentile_high]*percentile_fraction;
      gate_db = max(GATE_ABSOLUTE_DBFS, p90_db-GATE_BELOW_P90_DB);

      memset(observation_counts, 0, max_capture_observations);
      memset(observation_shape_db, 0, max_capture_observations*PROFILE_BINS);

      frame_index = 0;
      loop(capture_frame_count,
        frame_rms_db[frame_index] >= gate_db ? (
          group_index = floor((frame_index*learn_hop_samples + FFT_SIZE/2)/
                              (OBSERVATION_SECONDS*srate));
          group_index = min(max_capture_observations-1, max(0, group_index));
          observation_counts[group_index] += 1;
          frame_offset = frame_index*PROFILE_BINS;
          group_offset = group_index*PROFILE_BINS;
          bin_index = 0;
          loop(PROFILE_BINS,
            observation_shape_db[group_offset+bin_index] +=
              frame_band_power[frame_offset+bin_index];
            bin_index += 1;
          );
        );
        frame_index += 1;
      );

      valid_observations = 0;
      group_index = 0;
      loop(max_capture_observations,
        accepted_count = observation_counts[group_index];
        accepted_count >= MIN_FRAMES_PER_OBSERVATION ? (
          group_offset = group_index*PROFILE_BINS;
          observation_index = valid_observations*PROFILE_BINS;
          normalise_sum = 0;
          normalise_count = 0;
          bin_index = 0;
          loop(PROFILE_BINS,
            frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
            observation_level = DB_SCALE_POWER*log(max(
              observation_shape_db[group_offset+bin_index]/accepted_count,
              EPSILON));
            observation_shape_db[observation_index+bin_index] = observation_level;
            frequency >= NORMALISE_LOW_HZ && frequency <= NORMALISE_HIGH_HZ ? (
              normalise_sum += observation_level;
              normalise_count += 1;
            );
            bin_index += 1;
          );
          normalise_sum /= max(1, normalise_count);
          bin_index = 0;
          loop(PROFILE_BINS,
            observation_shape_db[observation_index+bin_index] -= normalise_sum;
            bin_index += 1;
          );
          valid_observations += 1;
        );
        group_index += 1;
      );

      // Short capture targets must not inherit the 24-second evidence floor.
      // Permit two silent or invalid two-second observations, with a floor of
      // three and the established ceiling of twelve.
      required_observation_count = required_learn_observations();

      valid_observations >= required_observation_count ? (
        trim_count = floor(valid_observations*TRIM_PROPORTION);
        first_kept = trim_count;
        last_kept = valid_observations-trim_count;
        bin_index = 0;
        loop(PROFILE_BINS,
          observation_index = 0;
          loop(valid_observations,
            sort_workspace[observation_index] =
              observation_shape_db[observation_index*PROFILE_BINS+bin_index];
            observation_index += 1;
          );
          sort_values(sort_workspace, valid_observations);
          value_sum = 0;
          value_count = 0;
          i = first_kept;
          while(i < last_kept) (
            value_sum += sort_workspace[i];
            value_count += 1;
            i += 1;
          );
          source_anchor_db[bin_index] = value_sum/max(1, value_count);
          bin_index += 1;
        );

        anchor_normalise_sum = 0;
        anchor_normalise_count = 0;
        bin_index = 0;
        loop(PROFILE_BINS,
          frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
          frequency >= NORMALISE_LOW_HZ && frequency <= NORMALISE_HIGH_HZ ? (
            anchor_normalise_sum += source_anchor_db[bin_index];
            anchor_normalise_count += 1;
          );
          bin_index += 1;
        );
        anchor_normalise_sum /= max(1, anchor_normalise_count);
        bin_index = 0;
        loop(PROFILE_BINS,
          source_anchor_db[bin_index] -= anchor_normalise_sum;
          bin_index += 1;
        );

        learned_valid = 1;
        learned_observation_count = valid_observations;
        accepted_observations = valid_observations;
        anchor_status = 3;
        reset_live_analysis();
        calculate_reference_curve();
      ) : (
        accepted_observations = valid_observations;
        anchor_status = 4;
      );
    ) : (
      accepted_observations = 0;
      anchor_status = 4;
    );

    learn_progress_percent = 100;
    learn_action = 0;
    // This function changes the slider internally, so @slider does not get a
    // user edge from Learn back to Idle. Reset the edge tracker explicitly so
    // a later Learn selection always starts a fresh capture.
    last_learn_action = 0;
    finalise_requested = 0;
    sliderchange(slider3);
    sliderchange(slider11);
    sliderchange(slider12);
    sliderchange(slider13);
  );

  // One update path serves host automation, preset recall and the custom GUI.
  // UI controls change the hidden sliders, notify the host with
  // slider_automate(), then call this function immediately.
  function apply_control_changes()
  (
    correction_shape_changed =
      reference_strength != last_reference_strength ||
      frequency_smoothing != last_frequency_smoothing;

    adaptivity != last_adaptivity ? (
      adaptivity <= 0 ? (
        // Zero Adaptivity means the deterministic Strength/Smoothing baseline,
        // never a frozen snapshot of the previous live consistency residual.
        memset(adaptive_state_db, 0, PROFILE_BINS);
        memset(adaptive_residual_db, 0, PROFILE_BINS);
        refresh_combined_curve();
        process_filter_force = 1;
      );
      last_adaptivity = adaptivity;
    );

    reference_low_hz > reference_high_hz ? (
      reference_low_hz = reference_high_hz;
      sliderchange(slider5);
    );

    reference_select != last_reference_select ? (
      set_profile_name(reference_select|0);
      last_reference_select = reference_select;
    );

    reference_select != last_curve_reference ||
    reference_low_hz != last_reference_low_hz ||
    reference_high_hz != last_reference_high_hz ||
    reference_strength != last_reference_strength ||
    frequency_smoothing != last_frequency_smoothing ? (
      calculate_reference_curve();
      correction_shape_changed ? (
        smooth_adaptive_curve();
        update_consistency_target(1);
        process_filter_force = 1;
      );
      last_curve_reference = reference_select;
      last_reference_low_hz = reference_low_hz;
      last_reference_high_hz = reference_high_hz;
      last_reference_strength = reference_strength;
      last_frequency_smoothing = frequency_smoothing;
    );

    auto_gain != last_auto_gain ? (
      last_auto_gain = auto_gain;
      process_filter_dirty = 1;
      process_filter_force = 1;
    );

    internal_bypass != last_internal_bypass ? (
      last_internal_bypass = internal_bypass;
      process_filter_dirty = 1;
      process_filter_force = 1;
    );

    phase_mode != last_phase_mode ? (
      last_phase_mode = phase_mode;
      reset_processing_runtime();
      process_filter_dirty = 1;
      process_filter_force = 1;
      set_processing_delay();
    );

    reset_action && !last_reset_action ? (
      capture_active = 0;
      finalise_requested = 0;
      learn_action = 0;
      clear_source_anchor();
      reset_action = 0;
      sliderchange(slider3);
      sliderchange(slider4);
    );

    learn_action && !last_learn_action && !capture_active ? reset_capture();
    !learn_action && last_learn_action && capture_active ? (
      finalise_reason = 2;
      finalise_requested = 1;
    );

    last_learn_action = learn_action;
    last_reset_action = reset_action;
  );

  function ui_hit(x, y, width, height)
  (
    mouse_x >= x && mouse_x <= x+width &&
    mouse_y >= y && mouse_y <= y+height;
  );

  function ui_panel(x, y, width, height)
  (
    gfx_set(0.055, 0.075, 0.075, 1);
    gfx_rect(x, y, width, height, 1);
    gfx_set(0.15, 0.20, 0.20, 1);
    gfx_roundrect(x, y, width, height, 7*ui_scale, 1);
  );

  function ui_button(x, y, width, height, active, hovered, warning)
  (
    active ? (
      warning ? gfx_set(0.24, 0.075, 0.065, 1) :
        gfx_set(0.09, 0.57, 0.50, 1);
    ) : hovered ? (
      warning ? gfx_set(0.16, 0.065, 0.06, 1) :
        gfx_set(0.085, 0.125, 0.125, 1);
    ) : gfx_set(0.045, 0.065, 0.065, 1);
    gfx_rect(x, y, width, height, 1);
    active ? (
      warning ? gfx_set(0.96, 0.38, 0.31, 1) :
        gfx_set(0.13, 0.84, 0.73, 1);
    ) : warning ? gfx_set(0.58, 0.23, 0.20, 1) :
      gfx_set(0.17, 0.23, 0.23, 1);
    gfx_roundrect(x, y, width, height, 6*ui_scale, 1);
  );

  function ui_track(x, y, width, fraction, enabled)
    local(handle_x)
  (
    fraction = max(0, min(1, fraction));
    handle_x = x+9*ui_scale+(width-18*ui_scale)*fraction;
    enabled ? gfx_set(0.76, 0.80, 0.79, 1) :
      gfx_set(0.34, 0.38, 0.37, 1);
    gfx_circle(handle_x, y, 9*ui_scale, 1, 1);
    enabled ? gfx_set(0.18, 0.24, 0.23, 1) :
      gfx_set(0.12, 0.15, 0.15, 1);
    gfx_circle(handle_x, y, 6.5*ui_scale, 1, 1);
    handle_x;
  );

  function ui_frequency_fraction(frequency)
  (
    log(max(MIN_FREQUENCY_HZ, min(MAX_FREQUENCY_HZ, frequency)) /
      MIN_FREQUENCY_HZ)/log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ);
  );

  function ui_frequency_from_fraction(fraction)
  (
    MIN_FREQUENCY_HZ*exp(log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)*
      max(0, min(1, fraction)));
  );

  function ui_brand_mark(x, y, size)
    local(center_x, mic_x, mic_y, diamond_x, diamond_y)
  (
    gfx_set(0.82, 0.87, 0.86, 1);
    gfx_roundrect(x, y, size, size, size*0.10, 1);
    mic_x = x+size*0.39;
    mic_y = y+size*0.17;
    gfx_roundrect(mic_x, mic_y, size*0.22, size*0.39, size*0.05, 1);
    gfx_line(x+size*0.50, y+size*0.56, x+size*0.50, y+size*0.76);
    gfx_line(x+size*0.36, y+size*0.76, x+size*0.64, y+size*0.76);
    diamond_x = x+size*0.50;
    diamond_y = y+size*0.48;
    gfx_set(0.92, 0.10, 0.07, 1);
    gfx_triangle(diamond_x, diamond_y-size*0.10,
      diamond_x-size*0.10, diamond_y,
      diamond_x, diamond_y+size*0.10);
    gfx_triangle(diamond_x, diamond_y-size*0.10,
      diamond_x+size*0.10, diamond_y,
      diamond_x, diamond_y+size*0.10);
  );

  // Exact NumPy-style symmetric Hann used in Stage 1.
  i = 0;
  loop(FFT_SIZE,
    window[i] = 0.5 - 0.5*cos(2*$pi*i/(FFT_SIZE-1));
    i += 1;
  );

  // Opt into REAPER's HiDPI surface. @gfx selects the matching 1x/2x skin and
  // scales all dynamic drawing and hit-test coordinates by the same factor.
  gfx_ext_retina = 1;
  #reference_menu =
    "None - Consistency Only|Alto 1 - Tess|Alto 2 - Andrea|Alto 3 - Amy|Baritone 1 - Luke|Baritone 2 - Jack|Baritone 3 - John|Bass 1 - Hakim|Bass 2 - Michael|Soprano 1 - Erin|Soprano 2 - Moira|Soprano 3 - Julia|Tenor 1 - Heath|Tenor 2 - Kyle|The Royer Track";
  ui_last_mouse_down = 0;
  ui_drag_control = 0;
  ui_drag_start_x = 0;
  ui_drag_start_value = 0;
  ui_reset_confirm = 0;
  capture_active = 0;
  finalise_requested = 0;
  learned_valid = 0;
  learned_observation_count = 0;
  stored_state_version = STATE_VERSION;
  last_learn_action = 0;
  last_reset_action = 0;
  last_reference_select = -1;
  last_reference_low_hz = -1;
  last_reference_high_hz = -1;
  last_reference_strength = -1;
  last_frequency_smoothing = -1;
  last_adaptivity = -1;
  last_phase_mode = phase_mode;
  last_auto_gain = -1;
  last_internal_bypass = -1;
  last_transport_running = 0;
  expected_play_position = -1;
  last_runtime_srate = srate;
  live_hop_samples = max(1, floor(srate/LIVE_ANALYSIS_RATE_HZ + 0.5));
  learn_action = 0;
  reset_action = 0;
  clear_source_anchor();
  set_profile_name(reference_select|0);
  reset_processing_runtime();
  build_processing_filter();

@slider
  apply_control_changes();

@block

  transport_running = play_state == 1 || play_state == 5;
  transport_discontinuity = 0;

  srate != last_runtime_srate ? (
    reset_live_analysis();
    reset_processing_runtime();
    process_filter_dirty = 1;
    process_filter_force = 1;
    live_hop_samples = max(1, floor(srate/LIVE_ANALYSIS_RATE_HZ + 0.5));
    last_runtime_srate = srate;
    expected_play_position = -1;
  );

  transport_running ? (
    !last_transport_running ? transport_discontinuity = 1;
    last_transport_running && expected_play_position >= 0 &&
    abs(play_position-expected_play_position) >
      max(0.05, 8*samplesblock/max(1, srate)) ? transport_discontinuity = 1;
    transport_discontinuity ? (
      reset_live_analysis();
      reset_processing_runtime();
    );
    expected_play_position = play_position + samplesblock/max(1, srate);
  ) : (
    last_transport_running ? (
      reset_live_analysis();
      reset_processing_runtime();
    );
    expected_play_position = -1;
  );
  last_transport_running = transport_running;

  process_filter_elapsed_samples += samplesblock;
  process_filter_dirty &&
  (process_filter_force || process_filter_elapsed_samples >=
    srate/PROCESS_FILTER_UPDATE_HZ) ? build_processing_filter();

  finalise_requested ? finalise_source_learning();

@sample

  mono_input = (spl0 + spl1)*0.5;

  capture_active ? (
    capture_gate_coefficient = mono_input*mono_input > capture_gate_power ?
      capture_gate_attack : capture_gate_release;
    capture_gate_power += capture_gate_coefficient*
      (mono_input*mono_input-capture_gate_power);
    capture_gate_level_db = DB_SCALE_POWER*log(max(capture_gate_power, EPSILON));
    capture_gate_peak_db = max(capture_gate_peak_db, capture_gate_level_db);
    capture_online_gate_db = max(GATE_ABSOLUTE_DBFS,
      capture_gate_peak_db-GATE_BELOW_P90_DB);
    capture_gate_level_db >= capture_online_gate_db ?
      capture_usable_sample_count += 1;

    analysis_ring[capture_ring_write] = mono_input;
    capture_ring_write += 1;
    capture_ring_write >= FFT_SIZE ? capture_ring_write = 0;
    capture_ring_filled = min(FFT_SIZE, capture_ring_filled+1);
    capture_hop_count += 1;
    capture_sample_count += 1;

    capture_ring_filled >= FFT_SIZE && capture_hop_count >= learn_hop_samples ? (
      analyse_capture_frame();
      capture_hop_count = 0;
    );

    learn_progress_percent = min(100,
      100*capture_usable_sample_count/max(1, learn_duration_seconds*srate));
    display_counter += 1;
    display_counter >= 2048 ? (
      slider11 = learn_progress_percent;
      sliderchange(slider11);
      display_counter = 0;
    );

    capture_usable_sample_count >= learn_duration_seconds*srate ? (
      capture_active = 0;
      finalise_reason = 1;
      finalise_requested = 1;
      anchor_status = 2;
      sliderchange(slider13);
    );
  ) : transport_running ? (
    analysis_ring[live_ring_write] = mono_input;
    live_ring_write += 1;
    live_ring_write >= FFT_SIZE ? live_ring_write = 0;
    live_ring_filled = min(FFT_SIZE, live_ring_filled+1);
    live_hop_count += 1;

    live_ring_filled >= FFT_SIZE && live_hop_count >= live_hop_samples ? (
      analyse_live_frame();
      live_hop_count = 0;
    );
  );

  processed_mono = process_output_block[process_output_read]*auto_gain_linear;
  process_output_read += 1;
  process_input_block[process_collect_count] = mono_input;
  process_collect_count += 1;
  process_collect_count >= PROCESS_PARTITION_SIZE ? (
    process_audio_block();
    process_collect_count = 0;
    process_output_read = 0;
  );

  spl0 = processed_mono;
  spl1 = processed_mono;

@gfx 1155 770

  // David's editable 3:2 artwork is the fixed coordinate system. The original
  // 2310x1540 file is exactly the 2x version of the 1155x770 logical surface.
  // The original coordinate survey was performed on a 1050x700 preview, so
  // 1.1 converts those measured positions to the final logical dimensions.
  ui_retina = gfx_ext_retina >= 2;
  ui_device_scale = ui_retina ? 2 : 1;
  ui_scale = 1.1*ui_device_scale;
  ui_canvas_w = 1050*ui_scale;
  ui_canvas_h = 700*ui_scale;

  // Interactive geometry follows the blank regions in Adaptive EQ GUI.png.
  ui_reference_field_x = 22*ui_scale;
  ui_reference_field_y = 137*ui_scale;
  ui_reference_field_w = 176*ui_scale;
  ui_reference_field_h = 38*ui_scale;
  ui_duration_x = 225*ui_scale;
  ui_duration_y = 137*ui_scale;
  ui_duration_w = 84*ui_scale;
  ui_duration_h = 38*ui_scale;
  ui_learn_button_x = 335*ui_scale;
  ui_learn_button_y = 108*ui_scale;
  ui_learn_button_w = 92*ui_scale;
  ui_learn_button_h = 30*ui_scale;
  ui_reset_x = 334*ui_scale;
  ui_reset_y = 151*ui_scale;
  ui_reset_w = 94*ui_scale;
  ui_reset_h = 31*ui_scale;

  ui_range_track_x = 454*ui_scale;
  ui_range_track_y = 144*ui_scale;
  ui_range_track_w = 145*ui_scale;
  ui_range_low_x = ui_range_track_x+7*ui_scale+
    (ui_range_track_w-14*ui_scale)*
    ui_frequency_fraction(reference_low_hz);
  ui_range_high_x = ui_range_track_x+7*ui_scale+
    (ui_range_track_w-14*ui_scale)*
    ui_frequency_fraction(reference_high_hz);

  ui_strength_track_x = 626*ui_scale;
  ui_smoothing_track_x = 720*ui_scale;
  ui_adaptivity_track_x = 813*ui_scale;
  ui_curve_track_y = 156*ui_scale;
  ui_curve_track_w = 77*ui_scale;

  ui_phase_x = 912*ui_scale;
  ui_phase_y = 126*ui_scale;
  ui_phase_w = 118*ui_scale;
  ui_phase_h = 30*ui_scale;
  ui_auto_x = 904*ui_scale;
  ui_auto_y = 166*ui_scale;
  ui_auto_w = 133*ui_scale;
  ui_auto_h = 42*ui_scale;
  ui_auto_track_x = 980*ui_scale;
  ui_auto_track_y = 186*ui_scale;
  ui_auto_track_w = 47*ui_scale;
  ui_bypass_x = 932*ui_scale;
  ui_bypass_y = 29*ui_scale;
  ui_bypass_w = 96*ui_scale;
  ui_bypass_h = 36*ui_scale;

  // These bounds are measured directly from the 2310x1540 master and divided
  // by two. They are not inherited from the earlier 1050px preview.
  graph_left = 56.5*ui_device_scale;
  graph_top = 261.5*ui_device_scale;
  graph_right = 1075.5*ui_device_scale;
  graph_bottom = 581.5*ui_device_scale;
  graph_width = graph_right-graph_left;
  graph_height = graph_bottom-graph_top;
  graph_db_min = -12;
  graph_db_max = 12;
  spectrum_db_min = -60;
  spectrum_db_max = 36;

  ui_mouse_down = (mouse_cap&1) == 1;
  ui_mouse_pressed = ui_mouse_down && !ui_last_mouse_down;
  ui_mouse_released = !ui_mouse_down && ui_last_mouse_down;

  // Learn duration is selected by clicking and committed by Return.
  ui_duration_edit_active ? (
    ui_key = gfx_getchar();
    ui_key >= 48 && ui_key <= 57 ? (
      ui_duration_edit_replace ? (
        ui_duration_edit_value = ui_key-48;
        ui_duration_edit_replace = 0;
      ) : ui_duration_edit_value = min(999,
        ui_duration_edit_value*10+ui_key-48);
    );
    ui_key == 8 ? (
      ui_duration_edit_replace ? ui_duration_edit_value = 0 :
        ui_duration_edit_value = floor(ui_duration_edit_value/10);
      ui_duration_edit_replace = 0;
    );
    ui_key == 13 || ui_key == 10 ? (
      learn_duration_seconds = max(10, min(300,
        ui_duration_edit_value));
      slider_automate(slider2);
      slider_automate(slider2, 1);
      sliderchange(-1);
      ui_duration_edit_active = 0;
    );
    ui_key == 27 ? ui_duration_edit_active = 0;
  );

  ui_reference_hover = ui_hit(ui_reference_field_x,
    ui_reference_field_y, ui_reference_field_w, ui_reference_field_h);
  ui_duration_hover = ui_hit(ui_duration_x, ui_duration_y,
    ui_duration_w, ui_duration_h);
  ui_learn_hover = ui_hit(ui_learn_button_x, ui_learn_button_y,
    ui_learn_button_w, ui_learn_button_h);
  ui_reset_hover = ui_hit(ui_reset_x, ui_reset_y, ui_reset_w, ui_reset_h);
  ui_range_hover = ui_hit(ui_range_track_x-6*ui_scale,
    ui_range_track_y-13*ui_scale, ui_range_track_w+12*ui_scale,
    26*ui_scale);
  ui_strength_hover = ui_hit(ui_strength_track_x-5*ui_scale,
    ui_curve_track_y-14*ui_scale, ui_curve_track_w+10*ui_scale,
    28*ui_scale);
  ui_smoothing_hover = ui_hit(ui_smoothing_track_x-5*ui_scale,
    ui_curve_track_y-14*ui_scale, ui_curve_track_w+10*ui_scale,
    28*ui_scale);
  ui_adaptivity_hover = ui_hit(ui_adaptivity_track_x-5*ui_scale,
    ui_curve_track_y-14*ui_scale, ui_curve_track_w+10*ui_scale,
    28*ui_scale);
  ui_phase_min_hover = ui_hit(ui_phase_x, ui_phase_y,
    ui_phase_w/2, ui_phase_h);
  ui_phase_linear_hover = ui_hit(ui_phase_x+ui_phase_w/2,
    ui_phase_y, ui_phase_w/2, ui_phase_h);
  ui_auto_hover = ui_hit(ui_auto_x, ui_auto_y, ui_auto_w, ui_auto_h);
  ui_bypass_hover = ui_hit(ui_bypass_x, ui_bypass_y,
    ui_bypass_w, ui_bypass_h);

  ui_mouse_pressed ? (
    !ui_reset_hover ? ui_reset_confirm = 0;

    ui_duration_edit_active && !ui_duration_hover ? (
      ui_duration_edit_value >= 10 ? (
        learn_duration_seconds = max(10, min(300,
          ui_duration_edit_value));
        slider_automate(slider2);
        slider_automate(slider2, 1);
        sliderchange(-1);
      );
      ui_duration_edit_active = 0;
    );

    ui_reference_hover ? (
      gfx_x = mouse_x;
      gfx_y = mouse_y;
      ui_menu_choice = gfx_showmenu(#reference_menu);
      ui_menu_choice > 0 ? (
        reference_select = ui_menu_choice-1;
        slider_automate(slider1);
        apply_control_changes();
        slider_automate(slider1, 1);
        sliderchange(-1);
      );
    );

    ui_duration_hover ? (
      ui_duration_edit_active = 1;
      ui_duration_edit_value = learn_duration_seconds;
      ui_duration_edit_replace = 1;
    );

    ui_learn_hover ? (
      learn_action = capture_active ? 0 : 1;
      slider_automate(slider3);
      apply_control_changes();
      slider_automate(slider3, 1);
      sliderchange(-1);
    );

    ui_reset_hover ? (
      ui_reset_confirm ? (
        reset_action = 1;
        slider_automate(slider4);
        apply_control_changes();
        slider_automate(slider4, 1);
        sliderchange(-1);
        ui_reset_confirm = 0;
      ) : ui_reset_confirm = 1;
    );

    ui_range_hover && reference_select > 0 ? (
      abs(mouse_x-ui_range_low_x) <= abs(mouse_x-ui_range_high_x) ?
        ui_drag_control = 2 : ui_drag_control = 3;
      ui_range_drag_last_x = mouse_x;
    );

    ui_click_time = time_precise();
    ui_strength_hover ? (
      ui_click_time-ui_strength_last_click < 0.35 ? (
        reference_strength = 66;
        slider_automate(slider7);
        apply_control_changes();
        slider_automate(slider7, 1);
        sliderchange(-1);
        ui_drag_control = 0;
      ) : ui_drag_control = 4;
      ui_strength_last_click = ui_click_time;
    );
    ui_smoothing_hover ? (
      ui_click_time-ui_smoothing_last_click < 0.35 ? (
        frequency_smoothing = 50;
        slider_automate(slider9);
        apply_control_changes();
        slider_automate(slider9, 1);
        sliderchange(-1);
        ui_drag_control = 0;
      ) : ui_drag_control = 5;
      ui_smoothing_last_click = ui_click_time;
    );
    ui_adaptivity_hover ? (
      ui_click_time-ui_adaptivity_last_click < 0.35 ? (
        adaptivity = 50;
        slider_automate(slider8);
        apply_control_changes();
        slider_automate(slider8, 1);
        sliderchange(-1);
        ui_drag_control = 0;
      ) : ui_drag_control = 6;
      ui_adaptivity_last_click = ui_click_time;
    );

    ui_phase_min_hover ? (
      phase_mode = 0;
      slider_automate(slider10);
      apply_control_changes();
      slider_automate(slider10, 1);
      sliderchange(-1);
    );
    ui_phase_linear_hover ? (
      phase_mode = 1;
      slider_automate(slider10);
      apply_control_changes();
      slider_automate(slider10, 1);
      sliderchange(-1);
    );
    ui_auto_hover ? (
      auto_gain = auto_gain ? 0 : 1;
      slider_automate(slider14);
      apply_control_changes();
      slider_automate(slider14, 1);
      sliderchange(-1);
    );
    ui_bypass_hover ? (
      internal_bypass = internal_bypass ? 0 : 1;
      slider_automate(slider15);
      apply_control_changes();
      slider_automate(slider15, 1);
      sliderchange(-1);
    );
  );

  ui_mouse_down ? (
    ui_drag_control == 2 ? (
      ui_range_dx = mouse_x-ui_range_drag_last_x;
      ui_range_precision = abs(ui_range_dx) <= 2 ? 0.12 :
        abs(ui_range_dx) <= 6 ? 0.45 : 1;
      ui_new_value = reference_low_hz*exp(ui_range_dx*
        ui_range_precision*log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)/
        max(1, ui_range_track_w-14*ui_scale));
      ui_new_value = max(20, min(reference_high_hz, ui_new_value));
      ui_new_value != reference_low_hz ? (
        reference_low_hz = ui_new_value;
        slider_automate(slider5);
        apply_control_changes();
      );
      ui_range_drag_last_x = mouse_x;
    );
    ui_drag_control == 3 ? (
      ui_range_dx = mouse_x-ui_range_drag_last_x;
      ui_range_precision = abs(ui_range_dx) <= 2 ? 0.12 :
        abs(ui_range_dx) <= 6 ? 0.45 : 1;
      ui_new_value = reference_high_hz*exp(ui_range_dx*
        ui_range_precision*log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)/
        max(1, ui_range_track_w-14*ui_scale));
      ui_new_value = min(20000, max(reference_low_hz, ui_new_value));
      ui_new_value != reference_high_hz ? (
        reference_high_hz = ui_new_value;
        slider_automate(slider6);
        apply_control_changes();
      );
      ui_range_drag_last_x = mouse_x;
    );
    ui_drag_control == 4 ? (
      ui_new_value = floor(200*(mouse_x-ui_strength_track_x-
        9*ui_scale)/max(1, ui_curve_track_w-18*ui_scale)+0.5);
      ui_new_value = max(0, min(200, ui_new_value));
      ui_new_value != reference_strength ? (
        reference_strength = ui_new_value;
        slider_automate(slider7);
        apply_control_changes();
      );
    );
    ui_drag_control == 5 ? (
      ui_new_value = floor(100*(mouse_x-ui_smoothing_track_x-
        9*ui_scale)/max(1, ui_curve_track_w-18*ui_scale)+0.5);
      ui_new_value = max(0, min(100, ui_new_value));
      ui_new_value != frequency_smoothing ? (
        frequency_smoothing = ui_new_value;
        slider_automate(slider9);
        apply_control_changes();
      );
    );
    ui_drag_control == 6 ? (
      ui_new_value = floor(100*(mouse_x-ui_adaptivity_track_x-
        9*ui_scale)/max(1, ui_curve_track_w-18*ui_scale)+0.5);
      ui_new_value = max(0, min(100, ui_new_value));
      ui_new_value != adaptivity ? (
        adaptivity = ui_new_value;
        slider_automate(slider8);
        apply_control_changes();
      );
    );
  );

  ui_mouse_released ? (
    ui_drag_control == 2 ? slider_automate(slider5, 1);
    ui_drag_control == 3 ? slider_automate(slider6, 1);
    ui_drag_control == 4 ? slider_automate(slider7, 1);
    ui_drag_control == 5 ? slider_automate(slider9, 1);
    ui_drag_control == 6 ? slider_automate(slider8, 1);
    ui_drag_control > 0 ? sliderchange(-1);
    ui_drag_control = 0;
  );

  mouse_wheel != 0 ? (
    ui_wheel_step = mouse_wheel > 0 ? 1 : -1;
    ui_strength_hover ? (
      reference_strength = max(0, min(200,
        reference_strength+ui_wheel_step));
      slider_automate(slider7);
      apply_control_changes();
      slider_automate(slider7, 1);
      sliderchange(-1);
    );
    ui_smoothing_hover ? (
      frequency_smoothing = max(0, min(100,
        frequency_smoothing+ui_wheel_step));
      slider_automate(slider9);
      apply_control_changes();
      slider_automate(slider9, 1);
      sliderchange(-1);
    );
    ui_adaptivity_hover ? (
      adaptivity = max(0, min(100,
        adaptivity+ui_wheel_step));
      slider_automate(slider8);
      apply_control_changes();
      slider_automate(slider8, 1);
      sliderchange(-1);
    );
    mouse_wheel = 0;
  );

  ui_last_mouse_down = ui_mouse_down;

  // Static skin. Slot zero is David's exact 2310x1540 original; slot one is
  // the corresponding 1155x770 standard-density derivative.
  gfx_set(0.005, 0.012, 0.014, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_set(1, 1, 1, 1);
  ui_skin_index = ui_retina ? 0 : 1;
  ui_skin_source_w = ui_retina ? 2310 : 1155;
  ui_skin_source_h = ui_retina ? 1540 : 770;
  gfx_blit(ui_skin_index, 1, 0, 0, 0,
    ui_skin_source_w, ui_skin_source_h,
    0, 0, ui_canvas_w, ui_canvas_h);

  // Source status in the intentionally blank header field.
  anchor_status == 1 ? #header_status = "LEARNING SOURCE" :
  anchor_status == 2 ? #header_status = "FINALISING" :
  anchor_status == 3 ? #header_status = "SOURCE LEARNED" :
  anchor_status == 4 ? #header_status = "LEARN INCOMPLETE" :
    #header_status = "SOURCE NOT LEARNED";
  gfx_setfont(1, "Avenir Next", floor(13*ui_scale));
  anchor_status == 3 ? gfx_set(0.16, 0.82, 0.72, 1) :
  anchor_status == 4 ? gfx_set(0.96, 0.46, 0.29, 1) :
    gfx_set(0.72, 0.78, 0.77, 1);
  gfx_measurestr(#header_status, ui_text_w, ui_text_h);
  gfx_x = 836*ui_scale-ui_text_w/2;
  gfx_y = 47*ui_scale-ui_text_h/2;
  gfx_drawstr(#header_status);

  // Reference selection.
  gfx_setfont(1, "Avenir Next", floor(13*ui_scale));
  gfx_set(0.91, 0.93, 0.92, 1);
  gfx_x = ui_reference_field_x+10*ui_scale;
  gfx_y = ui_reference_field_y+11*ui_scale;
  gfx_drawstr(#profile_name, 0,
    ui_reference_field_x+ui_reference_field_w-25*ui_scale,
    ui_reference_field_y+ui_reference_field_h);

  // Learn time and action buttons.
  gfx_setfont(1, "Avenir Next", floor(15*ui_scale));
  gfx_set(0.15, 0.78, 0.70, 1);
  ui_duration_edit_active ?
    sprintf(#duration_text, "%d|", ui_duration_edit_value) :
    sprintf(#duration_text, "%.0f s", learn_duration_seconds);
  gfx_measurestr(#duration_text, ui_text_w, ui_text_h);
  gfx_x = ui_duration_x+(ui_duration_w-ui_text_w)/2;
  gfx_y = ui_duration_y+(ui_duration_h-ui_text_h)/2;
  gfx_drawstr(#duration_text);

  gfx_setfont(1, "Avenir Next", floor(12*ui_scale));
  capture_active ? gfx_set(0.02, 0.10, 0.09, 1) :
    gfx_set(0.02, 0.10, 0.09, 1);
  capture_active ? #learn_button_text = "STOP LEARN" :
    #learn_button_text = "LEARN SOURCE";
  gfx_measurestr(#learn_button_text, ui_text_w, ui_text_h);
  gfx_x = ui_learn_button_x+(ui_learn_button_w-ui_text_w)/2+3*ui_scale;
  gfx_y = ui_learn_button_y+(ui_learn_button_h-ui_text_h)/2;
  gfx_drawstr(#learn_button_text);
  gfx_set(0.84, 0.88, 0.87, 1);
  ui_reset_confirm ? #reset_button_text = "CLICK AGAIN" :
    #reset_button_text = "RESET SOURCE";
  gfx_measurestr(#reset_button_text, ui_text_w, ui_text_h);
  gfx_x = ui_reset_x+(ui_reset_w-ui_text_w)/2+3*ui_scale;
  gfx_y = ui_reset_y+(ui_reset_h-ui_text_h)/2;
  gfx_drawstr(#reset_button_text);

  // Cover the baked default endpoint labels, then draw the live values.
  gfx_set(0.025, 0.055, 0.064, 1);
  gfx_rect(451*ui_scale, 158*ui_scale, 49*ui_scale, 15*ui_scale, 1);
  gfx_rect(566*ui_scale, 158*ui_scale, 50*ui_scale, 15*ui_scale, 1);
  gfx_setfont(1, "Avenir Next", floor(11*ui_scale));
  reference_select > 0 ? gfx_set(0.87, 0.90, 0.89, 1) :
    gfx_set(0.42, 0.47, 0.46, 1);
  reference_low_hz >= 1000 ?
    sprintf(#range_low_text, "%.1fkHz", reference_low_hz/1000) :
  reference_low_hz < 100 ?
    sprintf(#range_low_text, "%.1fHz", reference_low_hz) :
    sprintf(#range_low_text, "%.0fHz", reference_low_hz);
  gfx_x = 454*ui_scale;
  gfx_y = 159*ui_scale;
  gfx_drawstr(#range_low_text);
  reference_high_hz >= 1000 ?
    sprintf(#range_high_text, "%.1fkHz", reference_high_hz/1000) :
  reference_high_hz < 100 ?
    sprintf(#range_high_text, "%.1fHz", reference_high_hz) :
    sprintf(#range_high_text, "%.0fHz", reference_high_hz);
  gfx_measurestr(#range_high_text, ui_text_w, ui_text_h);
  gfx_x = 599*ui_scale-ui_text_w;
  gfx_y = 159*ui_scale;
  gfx_drawstr(#range_high_text);

  // In consistency-only mode the baked range tube is covered completely so
  // it does not imply that a disabled-looking control should be selectable.
  reference_select <= 0 ? (
    gfx_set(0.0275, 0.0627, 0.0784, 1);
    gfx_rect(ui_range_track_x-3*ui_scale,
      ui_range_track_y-12*ui_scale, ui_range_track_w+6*ui_scale,
      24*ui_scale, 1);
  ) : (
    gfx_set(0.10, 0.75, 0.68, 1);
    gfx_rect(ui_range_low_x, ui_range_track_y-ui_scale,
      max(0, ui_range_high_x-ui_range_low_x), 2*ui_scale, 1);
    gfx_set(0.78, 0.82, 0.81, 1);
    gfx_circle(ui_range_low_x, ui_range_track_y, 7*ui_scale, 1, 1);
    gfx_circle(ui_range_high_x, ui_range_track_y, 7*ui_scale, 1, 1);
    gfx_set(0.16, 0.22, 0.21, 1);
    gfx_circle(ui_range_low_x, ui_range_track_y, 4.5*ui_scale, 1, 1);
    gfx_circle(ui_range_high_x, ui_range_track_y, 4.5*ui_scale, 1, 1);
  );

  ui_strength_handle_x = ui_track(ui_strength_track_x,
    ui_curve_track_y, ui_curve_track_w,
    reference_strength/200, 1);
  ui_smoothing_handle_x = ui_track(ui_smoothing_track_x,
    ui_curve_track_y, ui_curve_track_w,
    frequency_smoothing/100, 1);
  ui_adaptivity_handle_x = ui_track(ui_adaptivity_track_x,
    ui_curve_track_y, ui_curve_track_w,
    adaptivity/100, 1);

  gfx_setfont(1, "Avenir Next", floor(8*ui_scale));
  gfx_set(0.92, 0.94, 0.93, 1);
  sprintf(#strength_text, "%.0f", reference_strength);
  sprintf(#smoothing_text, "%.0f", frequency_smoothing);
  sprintf(#adaptivity_value_text, "%.0f", adaptivity);
  gfx_measurestr(#strength_text, ui_text_w, ui_text_h);
  gfx_x = ui_strength_track_x+(ui_curve_track_w-ui_text_w)/2;
  gfx_y = 182*ui_scale;
  gfx_drawstr(#strength_text);
  gfx_measurestr(#smoothing_text, ui_text_w, ui_text_h);
  gfx_x = ui_smoothing_track_x+(ui_curve_track_w-ui_text_w)/2;
  gfx_y = 182*ui_scale;
  gfx_drawstr(#smoothing_text);
  gfx_measurestr(#adaptivity_value_text, ui_text_w, ui_text_h);
  gfx_x = ui_adaptivity_track_x+(ui_curve_track_w-ui_text_w)/2;
  gfx_y = 182*ui_scale;
  gfx_drawstr(#adaptivity_value_text);

  // Phase selector and auto-gain toggle.
  ui_phase_underline_y = ui_phase_y+ui_phase_h-5*ui_scale;
  phase_mode < 0.5 ? (
    gfx_set(0.12, 0.80, 0.72, 1);
    gfx_rect(ui_phase_x+8*ui_scale, ui_phase_underline_y,
      ui_phase_w/2-16*ui_scale, 3*ui_scale, 1);
  ) : (
    gfx_set(0.12, 0.80, 0.72, 1);
    gfx_rect(ui_phase_x+ui_phase_w/2+8*ui_scale,
      ui_phase_underline_y, ui_phase_w/2-16*ui_scale,
      3*ui_scale, 1);
  );
  // The PNG owns the phase labels; JSFX only supplies the selected-state tint.
  auto_gain ? (
    // Opaque dark green keeps the overlapping capsule primitives one colour.
    gfx_set(0.07, 0.45, 0.41, 1);
    gfx_rect(ui_auto_track_x+10*ui_scale,
      ui_auto_track_y-10*ui_scale, ui_auto_track_w-20*ui_scale,
      20*ui_scale, 1);
    gfx_circle(ui_auto_track_x+10*ui_scale, ui_auto_track_y,
      10*ui_scale, 1, 1);
    gfx_circle(ui_auto_track_x+ui_auto_track_w-10*ui_scale,
      ui_auto_track_y, 10*ui_scale, 1, 1);
    gfx_set(0.92, 0.94, 0.93, 1);
    gfx_circle(ui_auto_track_x+ui_auto_track_w-10*ui_scale,
      ui_auto_track_y, 7*ui_scale, 1, 1);
  ) : (
    gfx_set(0.72, 0.76, 0.75, 1);
    gfx_circle(ui_auto_track_x+10*ui_scale, ui_auto_track_y,
      7*ui_scale, 1, 1);
  );

  // Latency-preserving internal bypass. Only the word is underlined; the
  // neighbouring power symbol remains visually untouched.
  internal_bypass ? gfx_set(0.96, 0.34, 0.27, 1) :
    gfx_set(0.14, 0.78, 0.70, 1);
  gfx_rect(1062*ui_device_scale, 62*ui_device_scale,
    59*ui_device_scale, 3*ui_device_scale, 1);

  // Reference range tint and markers use the same logarithmic mapping as the
  // graph and the range control.
  low_x = graph_left + log(max(MIN_FREQUENCY_HZ,
    reference_low_hz)/MIN_FREQUENCY_HZ)/
    log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)*graph_width;
  high_x = graph_left + log(min(MAX_FREQUENCY_HZ,
    reference_high_hz)/MIN_FREQUENCY_HZ)/
    log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)*graph_width;
  reference_select > 0 ? (
    gfx_set(0.10, 0.80, 0.73, 0.045);
    gfx_rect(low_x, graph_top, max(0, high_x-low_x), graph_height, 1);
    gfx_set(0.10, 0.80, 0.73, 0.70);
    gfx_rect(low_x-ui_scale, graph_top, 2*ui_scale, graph_height, 1);
    gfx_rect(high_x-ui_scale, graph_top, 2*ui_scale, graph_height, 1);
  );

  // The analyser is useful before learning and is also positive feedback that
  // the plugin is receiving audio, so it is not gated by learned_valid.
  display_initialized ? (
      bin_index = 0;
      gfx_set(0.55, 0.58, 0.58, 0.28);
      loop(PROFILE_BINS-1,
        frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
        next_frequency = MIN_FREQUENCY_HZ*
          exp(log(2)*(bin_index+1)/BINS_PER_OCTAVE);
        curve_x = graph_left + log(frequency/MIN_FREQUENCY_HZ)/
          log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)*graph_width;
        next_x = graph_left + log(next_frequency/MIN_FREQUENCY_HZ)/
          log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)*graph_width;
        curve_y = graph_top +
          (spectrum_db_max-display_shape_db[bin_index])/
          (spectrum_db_max-spectrum_db_min)*graph_height;
        curve_y = max(graph_top, min(graph_bottom, curve_y));
        gfx_rect(curve_x, curve_y,
          max(ui_scale, next_x-curve_x+ui_scale),
          graph_bottom-curve_y, 1);
        bin_index += 1;
      );
  );

  learned_valid ? (
    // One white line: the complete correction requested of the processor.
    bin_index = 0;
    gfx_set(0.96, 0.97, 0.96, 1);
    loop(PROFILE_BINS,
      frequency = MIN_FREQUENCY_HZ*exp(log(2)*bin_index/BINS_PER_OCTAVE);
      curve_db = total_correction_db[bin_index];
      curve_x = graph_left + log(frequency/MIN_FREQUENCY_HZ)/
        log(MAX_FREQUENCY_HZ/MIN_FREQUENCY_HZ)*graph_width;
      curve_y = graph_top + (graph_db_max-curve_db)/
        (graph_db_max-graph_db_min)*graph_height;
      curve_y = max(graph_top, min(graph_bottom, curve_y));
      bin_index == 0 ? (
        gfx_x = curve_x;
        gfx_y = curve_y;
      ) : gfx_lineto(curve_x, curve_y, 1);
      bin_index += 1;
    );
  );

  // The footer carries the only user-facing runtime status plus output trim.
  gfx_setfont(1, "Avenir Next", floor(14*ui_scale));
  capture_active ? (
    gfx_set(0.15, 0.86, 0.75, 1);
    sprintf(#learn_progress_readout,
      "LEARNING: %.1fs AUDIO OF %.0fs TARGET  /  %.1fs ELAPSED",
      capture_usable_sample_count/max(1, srate), learn_duration_seconds,
      capture_sample_count/max(1, srate));
  ) : anchor_status == 2 ? (
    gfx_set(0.15, 0.86, 0.75, 1);
    #learn_progress_readout = "FINALISING LEARNED SOURCE...";
  ) : anchor_status == 3 ? (
    gfx_set(0.64, 0.72, 0.70, 1);
    #learn_progress_readout = "LEARNED SOURCE READY";
  ) : anchor_status == 4 ? (
    gfx_set(0.96, 0.46, 0.29, 1);
    #learn_progress_readout = "LEARN INCOMPLETE - PREVIOUS SOURCE RETAINED";
  ) : (
    gfx_set(0.64, 0.72, 0.70, 1);
    sprintf(#learn_progress_readout, "READY TO LEARN: %.0fs TARGET",
      learn_duration_seconds);
  );
  gfx_x = 26*ui_scale;
  gfx_y = 647*ui_scale;
  gfx_drawstr(#learn_progress_readout, 0,
    344*ui_scale, 679*ui_scale);

  gfx_setfont(1, "Avenir Next", floor(14*ui_scale));
  auto_gain ? (
    gfx_set(0.15, 0.86, 0.75, 1);
    sprintf(#footer_readout, "%+.2f dB", auto_gain_db);
  ) : (
    gfx_set(0.58, 0.63, 0.62, 1);
    #footer_readout = "OFF";
  );
  gfx_measurestr(#footer_readout, ui_text_w, ui_text_h);
  gfx_x = 968*ui_scale-ui_text_w/2;
  gfx_y = 654*ui_scale-ui_text_h/2;
  gfx_drawstr(#footer_readout);


@serialize

  serialise_writing = file_avail(0) < 0;
  stored_state_version = STATE_VERSION;
  file_var(0, stored_state_version);
  file_var(0, learned_valid);
  file_var(0, learned_observation_count);
  serialise_index = 0;
  loop(PROFILE_BINS,
    file_var(0, source_anchor_db[serialise_index]);
    serialise_index += 1;
  );

  !serialise_writing ? (
    stored_state_version != STATE_VERSION ? clear_source_anchor();
    accepted_observations = learned_observation_count;
    anchor_status = learned_valid ? 3 : 0;
    reset_live_analysis();
    calculate_reference_curve();
    sliderchange(slider12);
    sliderchange(slider13);
  );
