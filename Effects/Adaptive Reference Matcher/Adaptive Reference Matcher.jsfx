// 12: Tenor 2 (Kyle McCarley) [tenor_2_kyle_mccarley]
// 13: The Royer Track [the_royer_track]

// Log grid is reconstructed as:
// frequency_hz = profile_min_frequency_hz * 2^(bin/profile_bins_per_octave)

